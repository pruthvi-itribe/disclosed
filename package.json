    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/schedule": "^4.1.2",
    "axios": "^1.19.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "mongoose": "^8.24.2",
    "node-telegram-bot-api": "^0.67.0",
