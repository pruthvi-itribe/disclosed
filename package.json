{
  "name": "turret",
  "version": "1.0.0",
  "description": "Low-latency ingest pipeline for NSE corporate filings",
  "main": "dist/apps/ingest/src/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build ingest && nest build enrichment && nest build dashboard",
    "build:ingest": "nest build ingest",
    "build:dashboard": "nest build dashboard",
    "start:dev": "nest start ingest --watch",
    "start:prod": "node dist/apps/ingest/src/main",
    "start:dashboard": "nest start dashboard",
    "start:dashboard:dev": "nest start dashboard --watch",
    "start:dashboard:prod": "node dist/apps/dashboard/src/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint \"{apps,libs,tools}/**/*.ts\" --fix",
    "corpus:fetch": "ts-node -r tsconfig-paths/register tools/corpus/fetch-corpus.ts",
    "corpus:analyse": "ts-node -r tsconfig-paths/register tools/corpus/analyse-corpus.ts",
    "amount:measure": "ts-node -r tsconfig-paths/register tools/extraction/measure-amount-precision.ts",
    "enrich:run": "ts-node -r tsconfig-paths/register tools/enrichment/enrich-filings.ts",
    "build:enrichment": "nest build enrichment",
    "start:enrichment": "nest start enrichment",
    "start:enrichment:dev": "nest start enrichment --watch",
    "start:enrichment:prod": "node dist/apps/ingest/src/enrichment.main",
    "claims:measure": "ts-node -r tsconfig-paths/register tools/claims/measure-claim-gate.ts",
    "claims:verify": "ts-node -r tsconfig-paths/register tools/claims/verify-corpus.ts"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.22",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "mongoose": "^8.24.2",
    "node-telegram-bot-api": "^0.67.0",
    "pdf-parse": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tough-cookie": "^4.1.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/pdf-parse": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.5.0",
    "nock": "^13.5.6",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "multer": "2.2.0",
    "express": "4.22.2",
    "body-parser": "1.20.6",
    "qs": "6.15.3"
  }
}
