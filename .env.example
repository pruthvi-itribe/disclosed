# Every numeric setting below must be a whole number >= 1. A blank assignment
# (KEY=) is read as "not set" and falls back to the default shown; anything else
# that is not a whole number >= 1 stops the process at startup naming the key.

MONGO_URI=mongodb://localhost:27117/turret

# Both are required to deliver anything. With either unset, alerts are written
# to the log instead and ingestion continues.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Minimum gap between two Telegram sends. Telegram allows roughly one message
# a second per chat and answers a burst with 429s, and a 429 is not a delay -
# it is an alert that is never delivered. Sends are queued and paced to this
# interval; rate-limited sends are counted and logged, never swallowed.
TELEGRAM_MIN_SEND_INTERVAL_MS=1000

# Poll cadence. Hot applies inside the 07:00-23:00 IST filing window, idle
# outside it.
NSE_HOT_INTERVAL_MS=2000
NSE_IDLE_INTERVAL_MS=30000

# How often the whole IST day is re-pulled and reconciled against what is
# stored, regardless of whether the live page rolled over. This is the safety
# net the no-loss guarantee rests on: measured over a 32-day corpus, no window
# shorter than a minute can roll the 20-record page, so a rollover-only drain
# runs about once per process lifetime. A closing drain also runs at 23:30 IST
# to reconcile the finished day; that time is fixed, not configurable.
NSE_DRAIN_INTERVAL_MS=300000

# Filings older than this are stored silently instead of alerting. It is what
# stops a cold-start drain of the day's records flooding the chat.
ALERT_WINDOW_MS=600000

# New records on one page at which the page is assumed to be turning over fast,
# so the next poll is issued immediately instead of waiting out the interval.
BURST_THRESHOLD=8

# Consecutive poll failures before the degraded alert is sent, once per outage.
FAILURE_THRESHOLD=3

# Comma-separated symbols the OPERATOR's own Telegram channel carries; matched
# case-insensitively, blanks ignored. Leave empty to alert on every non-routine
# filing.
#
# NAMED FOR ITS OWNER, and it was `WATCHLIST` until per-user watchlists existed.
# A reader's watchlist is a document in the `watchlists` collection and is
# unrelated to this key; while one word meant both, setting this to one symbol
# would have silenced every subscriber watching anything else. The old key is
# REFUSED AT STARTUP rather than ignored - read as absent it is the firehose
# below, which is the opposite of what whoever set it asked for.
#
# WARNING - LEAVING THIS EMPTY IS A FIREHOSE, AND THE SHIPPED VALUE IS EMPTY.
# Measured over a real 32-day corpus, 12,415 of 17,442 filings (71.2%) survive
# the routine-category gate, which is about 388 Telegram messages a day and a
# peak of 106 in one hour. A channel at that volume gets muted within a day -
# and every operator alert (INGEST DEGRADED, BLIND, DRAIN FAILED, WRITE FAILED,
# RECORDS SKIPPED) is muted with it, so the pipeline goes dark exactly when it
# most needs to be heard. Set a watchlist before pointing this at a chat you
# rely on. The poller logs this warning at startup too.
OPERATOR_WATCHLIST=

# --- notable-claim extraction -------------------------------------------------

# Which model provider is asked to propose claims. One of `anthropic` or
# `openrouter`; anything else stops the process at startup naming this key,
# because an unrecognised provider selects no adapter at all and presents as an
# extractor that has silently stopped working.
#
# The provider decides two other things: which API key is required, and which
# model is used when CLAIM_MODEL is unset. Setting only this variable therefore
# gives a working configuration rather than one provider pointed at the other
# one's model id.
CLAIM_PROVIDER=anthropic

# The key for whichever provider is selected. The other one is read but unused,
# so both can be left set while switching between them. With no key the lane
# records `extractor-unavailable` against every eligible filing and everything
# else in the pipeline is unaffected - a supported state, not a failure.
#
# NEVER COMMIT A REAL VALUE HERE. This file is committed; `.env` is not.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# The model. Defaults per provider: `claude-opus-5` for anthropic,
# `deepseek/deepseek-v4-flash-0731` for openrouter.
#
# The cost/quality trade is the operator's, and `npm run claims:compare` exists
# to make it on numbers - it runs both providers over the same filings and
# reports the INVENTION RATE, which is how often a model quotes a sentence the
# document does not contain. A cheaper model that invents more is not cheaper.
CLAIM_MODEL=

# Thinking depth and token spend: low, medium, high, xhigh or max. The
# OpenAI-compatible ladder has only three rungs, so xhigh and max reach
# OpenRouter as `high`.
CLAIM_EFFORT=medium

# False stops any model being called at all. Nothing else changes.
CLAIM_ENABLED=true

# The most verified claims one wire line may carry. Three is what the format
# carries before a line stops being readable at a glance.
CLAIM_MAX_CLAIMS=3

# How much of a document reaches the model. Measured rather than assumed: at
# 24,000 characters the claim lane lost two accepted claims and one wire line
# against 96,000, for +17% per document. The results lane uses the same value
# and needs it: a statutory statement is not at the front of the document - in
# one measured filing the consolidated statement begins at character 7,400 and
# the standalone one at 21,900.
CLAIM_MAX_DOCUMENT_CHARS=96000

# --- financial-results extraction ---------------------------------------------

# False stops the results table being read. Nothing else changes.
#
# SEPARATE FROM CLAIM_ENABLED because the two lanes cost separately and are
# useful separately: a desk that wants quarterly numbers and no narrative claims
# is a real configuration, and so is the reverse. The provider, key, model and
# effort above are shared - asking two models would make the two lanes
# incomparable for no benefit.
RESULTS_ENABLED=true

# --- apps/dashboard (read-only viewer) ---------------------------------------

# Port for the read-only dashboard. Must be a whole number between 1024 and
# 65535; anything else stops that process at startup naming the key. The
# dashboard ALWAYS binds 127.0.0.1 and there is deliberately no setting for the
# interface: it is an unauthenticated view of an unauthenticated database, and
# a typo turning that into 0.0.0.0 would publish the whole collection to the
# local network.
#
# 7717 rather than 3000 because 3000, 4000, 5000 and 8081 are all commonly
# already listening on a development machine.
#
# The dashboard reads MONGO_URI above; it opens no other connection. It creates
# indexes on the three collections it OWNS - users, sessions, watchlists - and
# never writes a filing or an index on one.
DASHBOARD_PORT=7717

# How long a signed-in session lives without being used, in whole days between
# 1 and 365. It slides forward on use, at most once an hour, so an active reader
# is not signed out mid-session and a device nobody has touched in a month stops
# being a way in.
#
# Anything that is not a whole number in range stops the dashboard at startup
# naming this key: a NaN here would put an Invalid Date in every session's
# expiresAt, which the TTL index cannot act on - so sessions would never expire.
SESSION_TTL_DAYS=30

# The one origin allowed to POST to the dashboard, checked against the request's
# Origin header on every mutation. The second CSRF layer after SameSite=Lax.
#
# Blank takes the default, which is this process's own loopback URL on
# DASHBOARD_PORT - correct for the shipped loopback deployment and wrong the
# moment a reverse proxy terminates TLS in front of it. Behind a proxy this MUST
# be the public https origin, or every sign-in from the real page is refused
# with 403 BAD_ORIGIN.
PUBLIC_ORIGIN=

# --- the optional Docling parser (hybrid parsing) ----------------------------

# Base URL of a running docling-serve, or empty for none.
#
# EMPTY IS THE SHIPPED DEFAULT AND A FULLY SUPPORTED DEPLOYMENT. With this
# unset every document is read by pdf-parse exactly as before: scanned filings
# reach no-text-layer, results filings are read by the flattening parser, and
# nothing fails. The pipeline is required to keep working on a machine with no
# Python on it, so this is a default rather than a fallback path.
#
# What setting it buys, measured over 38 real filings in the parsing spike:
#   - the 1.11% of filings that are raster scans become readable at all.
#     pdf-parse returns 2 to 97 characters for them, median 8; Docling with OCR
#     recovered 20 of 20 with 25 of 25 ground-truth digits verbatim.
#   - the 8.66% that carry a results table get the right reading order. In the
#     Apollo Tyres Q1 FY27 filing pdf-parse puts the standalone statement's rows
#     2,977 characters BEFORE its own title, so a nearest-preceding-heading rule
#     reads consolidated for a standalone row - a wrong number about a named
#     listed company. Docling puts the heading first. Its malformed-number rate
#     on results filings is 0.00% against pdf-parse's 3.98%.
#
# What it costs: a Python service holding 2.3-2.6 GB resident with OCR off and
# 3.8-7.4 GB with it on, and roughly 50x pdf-parse's parse time on the ~10% of
# documents that reach it. See the README for how to install and run it.
DOCLING_URL=

# How long one conversion may take, in milliseconds.
#
# DELIBERATELY LONG. Docling measures 2.5-4 seconds a PAGE with OCR, and the
# 129-page POLICYBZR results filing took 414 seconds in the spike. A timeout
# tuned to an ordinary web request would abandon every large results filing at
# the moment it was about to succeed. Affordable because the enrichment worker
# is its own OS process, off the poller's two-second path, holding a ten-minute
# lease on the one filing it is working on.
#
# NOTE that docling-serve has its OWN ceiling, DOCLING_SERVE_MAX_SYNC_WAIT,
# which defaults to 120 seconds and answers 504 past it while still finishing
# the work. Raise it on the service side to match this. A live run hit exactly
# that: a 15-page scan took 131 seconds, the service returned 504 at 120, and
# the document was lost even though the conversion had completed.
DOCLING_TIMEOUT_MS=300000

# How long a failure to REACH the service stops further requests being made.
#
# Without it a service that is down but reachable - a hung process, a container
# starting - costs the full timeout on every eligible filing. At ~85 results
# filings a day and a 300-second ceiling that is seven hours of a worker
# waiting on a dependency the design calls optional.
#
# It opens ONLY when no response arrived at all. An HTTP status is proof the
# service is alive, and treating a 504 on one oversized document as an outage
# skipped 19 convertible filings behind it in a live run.
DOCLING_COOLDOWN_MS=300000
