# Every numeric setting below must be a whole number >= 1. A blank assignment
# (KEY=) is read as "not set" and falls back to the default shown; anything else
# that is not a whole number >= 1 stops the process at startup naming the key.

MONGO_URI=mongodb://localhost:27117/redbox

# Both are required to deliver anything. With either unset, alerts are written
# to the log instead and ingestion continues.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Minimum gap between two Telegram sends. Telegram allows roughly one message
# a second per chat and answers a burst with 429s, and a 429 is not a delay -
# it is an alert that is never delivered. Sends are queued and paced to this
# interval; rate-limited sends are counted and logged, never swallowed.
TELEGRAM_MIN_SEND_INTERVAL_MS=1000

# Poll cadence. Hot applies inside the 07:00-23:00 IST filing window, idle
# outside it.
NSE_HOT_INTERVAL_MS=2000
NSE_IDLE_INTERVAL_MS=30000

# How often the whole IST day is re-pulled and reconciled against what is
# stored, regardless of whether the live page rolled over. This is the safety
# net the no-loss guarantee rests on: measured over a 32-day corpus, no window
# shorter than a minute can roll the 20-record page, so a rollover-only drain
# runs about once per process lifetime. A closing drain also runs at 23:30 IST
# to reconcile the finished day; that time is fixed, not configurable.
NSE_DRAIN_INTERVAL_MS=300000

# Filings older than this are stored silently instead of alerting. It is what
# stops a cold-start drain of the day's records flooding the chat.
ALERT_WINDOW_MS=600000

# New records on one page at which the page is assumed to be turning over fast,
# so the next poll is issued immediately instead of waiting out the interval.
BURST_THRESHOLD=8

# Consecutive poll failures before the degraded alert is sent, once per outage.
FAILURE_THRESHOLD=3

# Comma-separated symbols to alert on; matched case-insensitively, blanks
# ignored. Leave empty to alert on every non-routine filing.
#
# WARNING - LEAVING THIS EMPTY IS A FIREHOSE, AND THE SHIPPED VALUE IS EMPTY.
# Measured over a real 32-day corpus, 12,415 of 17,442 filings (71.2%) survive
# the routine-category gate, which is about 388 Telegram messages a day and a
# peak of 106 in one hour. A channel at that volume gets muted within a day -
# and every operator alert (INGEST DEGRADED, BLIND, DRAIN FAILED, WRITE FAILED,
# RECORDS SKIPPED) is muted with it, so the pipeline goes dark exactly when it
# most needs to be heard. Set a watchlist before pointing this at a chat you
# rely on. The poller logs this warning at startup too.
WATCHLIST=
