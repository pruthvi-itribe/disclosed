<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The SHAPE of the iOS Firebase config, values elided: the real file is
     operator-supplied at build time and never tracked (each carries an API
     key the repo-hygiene build refuses). Download yours from your own
     Firebase project's iOS app and place it at ios/App/App/. A contributor
     cannot use the project's own config anyway - the OAuth client is bound
     to the bundle id and signing certificates. -->
<plist version="1.0">
<dict>
	<key>CLIENT_ID</key>
	<string>&lt;ios-oauth-client-id&gt;.apps.googleusercontent.com</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.&lt;ios-oauth-client-id&gt;</string>
	<key>API_KEY</key>
	<string>&lt;firebase-ios-api-key&gt;</string>
	<key>GCM_SENDER_ID</key>
	<string>&lt;project-number&gt;</string>
	<key>BUNDLE_ID</key>
	<string>app.disclosed.mobile</string>
	<key>PROJECT_ID</key>
	<string>&lt;firebase-project-id&gt;</string>
	<key>GOOGLE_APP_ID</key>
	<string>&lt;firebase-ios-app-id&gt;</string>
</dict>
</plist>
