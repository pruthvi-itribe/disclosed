{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/ingest/src",
  "monorepo": true,
  "root": "apps/ingest",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/ingest/tsconfig.app.json"
  },
  "projects": {
    "ingest": {
      "type": "application",
      "root": "apps/ingest",
      "entryFile": "main",
      "sourceRoot": "apps/ingest/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ingest/tsconfig.app.json"
      }
    },
    "dashboard": {
      "type": "application",
      "root": "apps/dashboard",
      "entryFile": "main",
      "sourceRoot": "apps/dashboard/src",
      "compilerOptions": {
        "tsConfigPath": "apps/dashboard/tsconfig.app.json",
        "assets": [
          {
            "include": "ui/assets/*.png",
            "outDir": "dist/apps/dashboard/src"
          }
        ]
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "filings": {
      "type": "library",
      "root": "libs/filings",
      "entryFile": "index",
      "sourceRoot": "libs/filings/src",
      "compilerOptions": {
        "tsConfigPath": "libs/filings/tsconfig.lib.json"
      }
    },
    "notify": {
      "type": "library",
      "root": "libs/notify",
      "entryFile": "index",
      "sourceRoot": "libs/notify/src",
      "compilerOptions": {
        "tsConfigPath": "libs/notify/tsconfig.lib.json"
      }
    },
    "accounts": {
      "type": "library",
      "root": "libs/accounts",
      "entryFile": "index",
      "sourceRoot": "libs/accounts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/accounts/tsconfig.lib.json"
      }
    },
    "enrichment": {
      "type": "application",
      "root": "apps/ingest",
      "entryFile": "enrichment.main",
      "sourceRoot": "apps/ingest/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ingest/tsconfig.app.json"
      }
    }
  }
}
